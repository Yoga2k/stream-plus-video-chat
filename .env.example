# ============================================================
# STREAM+ VIDEO CHAT — PRODUCTION HOSTING ENVIRONMENT VARIABLES
# ============================================================

# 1. Server & Admin CCTV Credentials (Login via User Login Page)
PORT=3000
NODE_ENV=production
ADMIN_EMAIL=admin@streamplus.chat
ADMIN_PASSWORD=admin123

# 2. MongoDB Atlas Cloud Database (512 MB Free Tier = 5,00,000+ Users)
# If left empty on localhost, automatically uses data/streamplus-db.json
MONGODB_URI=
MONGODB_DB_NAME=streamplus

# 3. Cloudflare R2 Bucket Storage (10 GB Free Tier for Report & NSFW Screenshots)
# If left empty, automatically stores .jpg files in data/uploads/reports/
R2_UPLOAD_WEBHOOK_URL=
R2_PUBLIC_BASE_URL=
R2_API_TOKEN=

# 4. WebRTC TURN Relay Server (For Jio / Mobile 4G/5G / College Wi-Fi NAT)
# Default OpenRelay TURN is built-in; set your own Cloudflare Calls or Metered.ca TURN here:
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
