              text: "                  ><span id=\"calculator-analysis-prompt\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    >Use REA to inspect Windows Calculator\342\200\231s % button. Recover"
