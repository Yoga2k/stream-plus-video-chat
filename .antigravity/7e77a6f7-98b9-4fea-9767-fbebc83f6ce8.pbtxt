  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef, useState } from \'react\';\nimport { Mic, MicOff, Video, VideoOff, Maximize, Sparkles, Camera } from \'lucide-react\';\n\ninterface LocalVideoProps {\n  micMuted: boolean;\n  videoMuted: boolean;\n  onToggleMic: () => void;\n  onToggleVideo: () => void;\n}\n\nexport const LocalVideo: React.FC<LocalVideoProps> = ({\n  micMuted,\n  videoMuted,\n  onToggleMic,\n  onToggleVideo,\n}) => {\n  const videoRef = useRef<HTMLVideoElement | null>(null);\n  const containerRef = useRef<HTMLDivElement | null>(null);\n  const [hasRealStream, setHasRealStream] = useState<boolean>(false);\n  const [blurBackground, setBlurBackground] = useState<boolean>(false);\n  const [streamError, setStreamError] = useState<string | null>(null);\n\n  // Request actual camera & mic with graceful simulated fallback\n  useEffect(() => {\n    let stream: MediaStream | null = null;\n    let isMounted = true;\n\n    async function initMedia() {\n      try {\n        if (!navigator?.mediaDevices?.getUserMedia) {\n          throw new Error(\'getUserMedia unsupported\');\n        }\n        stream = await navigator.mediaDevices.getUserMedia({\n          video: { width: { ideal: 640 }, height: { ideal: 480 } },\n          audio: true,\n        });\n\n        if (!isMounted) {\n          stream.getTracks().forEach((track) => track.stop());\n          return;\n        }\n\n        if (videoRef.current) {\n          videoRef.current.srcObject = stream;\n        }\n        setHasRealStream(true);\n        setStreamError(null);\n      } catch (err) {\n        if (isMounted) {\n          setHasRealStream(false);\n          setStreamError(err instanceof Error ? err.name : \'Simulated Camera\');\n        }\n      }\n    }\n\n    initMedia();\n\n    return () => {\n      isMounted = false;\n      if (stream) {\n        stream.getTracks().forEach((track) => track.stop());\n      }\n    };\n  }, []);\n\n  // Update track enabled state when muted\n  useEffect(() => {\n    if (videoRef.current && videoRef.current.srcObject) {\n      const stream = videoRef.current.srcObject as MediaStream;\n      stream.getAudioTracks().forEach((t) => {\n        t.enabled = !micMuted;\n      });\n      stream.getVideoTracks().forEach((t) => {\n        t.enabled = !videoMuted;\n      });\n    }\n  }, [micMuted, videoMuted]);\n\n  // Fullscreen helper\n  const handleFullscreen = () => {\n    if (!containerRef.current) return;\n    if (!document.fullscreenElement) {\n      containerRef.current.requestFullscreen?.().catch(() => {});\n    } else {\n      document.exitFullscreen?.().catch(() => {});\n    }\n  };\n\n  return (\n    <div\n      ref={containerRef}\n      className=\"relative w-full h-full bg-slate-950 overflow-hidden flex items-center justify-center select-none\"\n    >\n      {/* Real Webcam Stream if available and video is on */}\n      {hasRealStream && !videoMuted ? (\n        <video\n          ref={videoRef}\n          autoPlay\n          playsInline\n          muted\n          className={`w-full h-full object-cover -scale-x-100 transition-all ${\n            blurBackground ? \'blur-xs\' : \'\'\n          }`}\n        />\n      ) : (\n        /* Realistic Simulated Webcam Canvas/Mock */\n        <div className=\"relative w-full h-full bg-gradient-to-tr from-slate-900 via-slate-950 to-slate-900 flex flex-col items-center justify-center p-4\">\n          {/* Subtle face frame guide */}\n          <div className=\"w-48 h-64 border-2 border-dashed border-amber-400/30 rounded-full flex flex-col items-center justify-center relative\">\n            <div className=\"w-24 h-24 rounded-full bg-gradient-to-tr from-amber-500 to-orange-500 flex items-center justify-center text-3xl font-black text-slate-950 shadow-inner mb-3\">\n              YOU\n            </div>\n            <span className=\"text-xs font-semibold text-slate-400\">\n              {videoMuted ? \'Camera Paused\' : \'Local Camera\'}\n            </span>\n            <span className=\"text-[10px] text-slate-500 mt-1\">\n              {hasRealStream ? \'Live Webcam Connected\' : \'Camera Ready\'}\n            </span>\n          </div>\n\n          {/* Fallback info note if webcam is not hardware-attached */}\n          {streamError && !videoMuted && (\n            <div className=\"absolute top-4 right-4 z-10 px-2.5 py-1 rounded-md bg-slate-900/90 border border-slate-800 text-[11px] text-amber-400 flex items-center gap-1.5 shadow-sm\">\n              <Camera size={12} />\n              <span>Simulated Feed</span>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Local Video Top-Left Label */}\n      <div className=\"absolute top-4 left-4 z-10 flex items-center gap-2\">\n        <span className=\"px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-md border border-slate-700/80 text-[11px] font-bold text-white shadow-sm\">\n          You\n        </span>\n        {micMuted && (\n          <span className=\"px-2 py-0.5 rounded bg-red-600/90 text-[10px] font-bold text-white shadow-sm flex items-center gap-1\">\n            <MicOff size={11} /> Muted\n          </span>\n        )}\n      </div>\n\n      {/* Local Video Floating Control Bar (Bottom Right) */}\n      <div className=\"absolute bottom-4 right-4 z-20 flex items-center gap-1.5 p-1 rounded-xl bg-slate-950/80 backdrop-blur-md border border-slate-800 shadow-xl\">\n        {/* Toggle Mic */}\n        <button\n          onClick={onToggleMic}\n          className={`p-2 rounded-lg transition-colors ${\n            micMuted\n              ? \'bg-red-600 text-white hover:bg-red-500\'\n              : \'text-slate-300 hover:text-white hover:bg-slate-800\'\n          }`}\n          title={micMuted ? \'Unmute microphone\' : \'Mute microphone\'}\n          aria-label={micMuted ? \'Unmute microphone\' : \'Mute microphone\'}\n        >\n          {micMuted ? <MicOff size={16} /> : <Mic size={16} />}\n        </button>\n\n        {/* Toggle Video */}\n        <button\n          onClick={onToggleVideo}\n          className={`p-2 rounded-lg transition-colors ${\n            videoMuted\n              ? \'bg-red-600 text-white hover:bg-red-500\'\n              : \'text-slate-300 hover:text-white hover:bg-slate-800\'\n          }`}\n          title={videoMuted ? \'Turn on video\' : \'Turn off video\'}\n          aria-label={videoMuted ? \'Turn on video\' : \'Turn off video\'}\n        >\n          {videoMuted ? <VideoOff size={16} /> : <Video size={16} />}\n        </button>\n\n        {/* Blur toggle */}\n        <button\n          onClick={() => setBlurBackground((prev) => !prev)}\n          className={`p-2 rounded-lg transition-colors ${\n            blurBackground\n              ? \'bg-amber-500 text-slate-950 hover:bg-amber-400\'\n              : \'text-slate-300 hover:text-white hover:bg-slate-800\'\n          }`}\n          title={blurBackground ? \'Disable blur\' : \'Enable blur background\'}\n          aria-label=\"Blur background\"\n        >\n          <Sparkles size={16} />\n        </button>\n\n        {/* Fullscreen */}\n        <button\n          onClick={handleFullscreen}\n          className=\"p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-colors\"\n          title=\"Fullscreen\"\n          aria-label=\"Fullscreen\"\n        >\n          <Maximize size={16} />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/LocalVideo.tsx"
        }
        overwrite: true
      }
    }
