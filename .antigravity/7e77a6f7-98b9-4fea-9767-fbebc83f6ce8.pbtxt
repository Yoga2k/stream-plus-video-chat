  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect, useCallback } from \'react\';\nimport { StreamHeader } from \'./components/StreamHeader.tsx\';\nimport { RemoteVideo } from \'./components/RemoteVideo.tsx\';\nimport { LocalVideo } from \'./components/LocalVideo.tsx\';\nimport { ControlsDock } from \'./components/ControlsDock.tsx\';\nimport { ChatBox, ChatMessage } from \'./components/ChatBox.tsx\';\nimport { AuthModal } from \'./components/AuthModal.tsx\';\nimport { RulesModal, ReportModal } from \'./components/RulesAndReportModals.tsx\';\nimport {\n  COUNTRIES,\n  CountryInfo,\n  StrangerProfile,\n  pickStranger,\n  getStrangerReply,\n  formatMessageTime,\n} from \'./utils/streamLogic.ts\';\nimport { sounds } from \'./utils/audioEffects.ts\';\n\nexport default function App() {\n  const [status, setStatus] = useState<\'stopped\' | \'searching\' | \'connected\'>(\'stopped\');\n  const [stranger, setStranger] = useState<StrangerProfile | null>(null);\n  const [selectedCountry, setSelectedCountry] = useState<CountryInfo>(COUNTRIES[0]);\n  const [gender, setGender] = useState<\'guy\' | \'girl\' | \'couple\'>(\'guy\');\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\n  const [isTyping, setIsTyping] = useState<boolean>(false);\n  const [onlineCount, setOnlineCount] = useState<number>(412890);\n  const [soundEnabled, setSoundEnabled] = useState<boolean>(true);\n  const [micMuted, setMicMuted] = useState<boolean>(false);\n  const [videoMuted, setVideoMuted] = useState<boolean>(false);\n  const [likeCount, setLikeCount] = useState<number>(0);\n  const [userProfile, setUserProfile] = useState<{ name: string } | null>(null);\n\n  // Modals\n  const [isAuthModalOpen, setIsAuthModalOpen] = useState<boolean>(true);\n  const [isRulesModalOpen, setIsRulesModalOpen] = useState<boolean>(false);\n  const [isReportModalOpen, setIsReportModalOpen] = useState<boolean>(false);\n\n  // Fluctuating online counter\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setOnlineCount((prev) => prev + Math.floor(Math.random() * 7) - 3);\n    }, 4000);\n    return () => clearInterval(timer);\n  }, []);\n\n  // Update audio effects state\n  useEffect(() => {\n    sounds.enabled = soundEnabled;\n  }, [soundEnabled]);\n\n  // Connect helper\n  const connectNewStranger = useCallback(\n    (currentStrangerId?: string) => {\n      setStatus(\'searching\');\n      setLikeCount(0);\n\n      const searchTimeout = setTimeout(() => {\n        const nextStranger = pickStranger(selectedCountry.code, currentStrangerId);\n        setStranger(nextStranger);\n        setStatus(\'connected\');\n        sounds.playConnect();\n\n        // System message\n        const sysMsg: ChatMessage = {\n          id: `sys-${Date.now()}`,\n          sender: \'system\',\n          text: `Connected with someone from ${nextStranger.country} ${nextStranger.flag}. Say hello!`,\n          time: formatMessageTime(),\n        };\n        setMessages((prev) => [...prev, sysMsg]);\n\n        // Stranger greeting after slight delay\n        setTimeout(() => {\n          setIsTyping(true);\n          setTimeout(() => {\n            setIsTyping(false);\n            const greetingText =\n              nextStranger.greetings[Math.floor(Math.random() * nextStranger.greetings.length)];\n            const greetMsg: ChatMessage = {\n              id: `stranger-${Date.now()}`,\n              sender: \'stranger\',\n              text: greetingText,\n              time: formatMessageTime(),\n              name: nextStranger.name,\n              flag: nextStranger.flag,\n            };\n            setMessages((prev) => [...prev, greetMsg]);\n            sounds.playMessage();\n          }, 1000);\n        }, 600);\n      }, 900);\n\n      return () => clearTimeout(searchTimeout);\n    },\n    [selectedCountry]\n  );\n\n  // Handle Start\n  const handleStart = () => {\n    connectNewStranger();\n  };\n\n  // Handle Next\n  const handleNext = () => {\n    sounds.playSkip();\n    const skipMsg: ChatMessage = {\n      id: `sys-${Date.now()}`,\n      sender: \'system\',\n      text: \'Partner skipped. Finding next person...\',\n      time: formatMessageTime(),\n    };\n    setMessages((prev) => [...prev, skipMsg]);\n    connectNewStranger(stranger?.id);\n  };\n\n  // Handle Stop\n  const handleStop = () => {\n    sounds.playSkip();\n    setStatus(\'stopped\');\n    setStranger(null);\n    setIsTyping(false);\n    const stopMsg: ChatMessage = {\n      id: `sys-${Date.now()}`,\n      sender: \'system\',\n      text: \'You disconnected. Press Start to begin a new chat.\',\n      time: formatMessageTime(),\n    };\n    setMessages((prev) => [...prev, stopMsg]);\n  };\n\n  // Handle Send Message\n  const handleSendMessage = (text: string) => {\n    const userMsg: ChatMessage = {\n      id: `user-${Date.now()}`,\n      sender: \'user\',\n      text,\n      time: formatMessageTime(),\n      name: userProfile?.name || \'You\',\n    };\n    setMessages((prev) => [...prev, userMsg]);\n    sounds.playMessage();\n\n    // Trigger stranger reply if connected\n    if (status === \'connected\' && stranger) {\n      setTimeout(() => {\n        setIsTyping(true);\n        setTimeout(() => {\n          setIsTyping(false);\n          const replyText = getStrangerReply(stranger, text);\n          const replyMsg: ChatMessage = {\n            id: `stranger-${Date.now()}`,\n            sender: \'stranger\',\n            text: replyText,\n            time: formatMessageTime(),\n            name: stranger.name,\n            flag: stranger.flag,\n          };\n          setMessages((prev) => [...prev, replyMsg]);\n          sounds.playMessage();\n        }, 1200);\n      }, 500);\n    }\n  };\n\n  // Handle Report confirmation\n  const handleConfirmReport = (reason: string) => {\n    const reportMsg: ChatMessage = {\n      id: `sys-${Date.now()}`,\n      sender: \'system\',\n      text: `User reported for \"${reason}\". Skipping partner...`,\n      time: formatMessageTime(),\n    };\n    setMessages((prev) => [...prev, reportMsg]);\n    handleNext();\n  };\n\n  // Keyboard shortcuts (F2/Space = Next/Start, Escape = Stop, M = Mute, V = Video)\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      // Ignore if user is currently typing in an input or textarea\n      const target = e.target as HTMLElement;\n      if (target?.tagName === \'INPUT\' || target?.tagName === \'TEXTAREA\') {\n        return;\n      }\n\n      if (e.key === \'F2\' || e.code === \'Space\') {\n        e.preventDefault();\n        if (status === \'stopped\') {\n          handleStart();\n        } else {\n          handleNext();\n        }\n      } else if (e.key === \'Escape\') {\n        e.preventDefault();\n        if (status !== \'stopped\') {\n          handleStop();\n        }\n      } else if (e.key === \'m\' || e.key === \'M\') {\n        e.preventDefault();\n        setMicMuted((prev) => !prev);\n      } else if (e.key === \'v\' || e.key === \'V\') {\n        e.preventDefault();\n        setVideoMuted((prev) => !prev);\n      }\n    };\n\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [status, stranger]);\n\n  return (\n    <div className=\"flex flex-col h-screen w-screen bg-slate-950 text-slate-100 overflow-hidden font-sans\">\n      {/* 1. Header Bar */}\n      <StreamHeader\n        onlineCount={onlineCount}\n        soundEnabled={soundEnabled}\n        onToggleSound={() => setSoundEnabled((prev) => !prev)}\n        onOpenRules={() => setIsRulesModalOpen(true)}\n        onOpenAuth={() => setIsAuthModalOpen(true)}\n        userProfile={userProfile}\n      />\n\n      {/* 2. Main Stage: Video Feeds (Left/Center) + Text Chat (Right) */}\n      <main className=\"flex-1 flex flex-col md:flex-row overflow-hidden relative\">\n        {/* Left Video Area: Video Feeds + Bottom Controls Dock */}\n        <div className=\"flex-1 flex flex-col min-w-0 h-full\">\n          {/* Twin Video Split Stage */}\n          <div className=\"flex-1 grid grid-cols-1 sm:grid-cols-2 bg-black min-h-0 relative\">\n            {/* Left Feed: Remote Partner */}\n            <RemoteVideo\n              status={status}\n              stranger={stranger}\n              onReport={() => setIsReportModalOpen(true)}\n              onLike={() => setLikeCount((prev) => prev + 1)}\n              likeCount={likeCount}\n            />\n\n            {/* Right Feed: Local User Webcam */}\n            <LocalVideo\n              micMuted={micMuted}\n              videoMuted={videoMuted}\n              onToggleMic={() => setMicMuted((prev) => !prev)}\n              onToggleVideo={() => setVideoMuted((prev) => !prev)}\n            />\n          </div>\n\n          {/* Bottom Chunky Controls Dock */}\n          <ControlsDock\n            status={status}\n            onStart={handleStart}\n            onNext={handleNext}\n            onStop={handleStop}\n            selectedCountry={selectedCountry}\n            onSelectCountry={(country) => {\n              setSelectedCountry(country);\n              if (status === \'connected\') {\n                handleNext();\n              }\n            }}\n            gender={gender}\n            onToggleGender={() => {\n              setGender((prev) => (prev === \'guy\' ? \'girl\' : prev === \'girl\' ? \'couple\' : \'guy\'));\n            }}\n          />\n        </div>\n\n        {/* Right Chat Panel */}\n        <aside className=\"w-full md:w-80 lg:w-96 h-64 md:h-full shrink-0 flex flex-col\">\n          <ChatBox\n            messages={messages}\n            onSendMessage={handleSendMessage}\n            status={status}\n            stranger={stranger}\n            isTyping={isTyping}\n            onOpenRules={() => setIsRulesModalOpen(true)}\n          />\n        </aside>\n      </main>\n\n      {/* 3. Rebranded OmeTV \"Become a Stream+ member!\" Modal */}\n      <AuthModal\n        isOpen={isAuthModalOpen}\n        onClose={() => setIsAuthModalOpen(false)}\n        onSignIn={(name) => {\n          setUserProfile({ name });\n          setIsAuthModalOpen(false);\n        }}\n        onlineCount={onlineCount}\n      />\n\n      {/* 4. Safety & Rules Modal */}\n      <RulesModal\n        isOpen={isRulesModalOpen}\n        onClose={() => setIsRulesModalOpen(false)}\n      />\n\n      {/* 5. Report User Modal */}\n      <ReportModal\n        isOpen={isReportModalOpen}\n        onClose={() => setIsReportModalOpen(false)}\n        onConfirmReport={handleConfirmReport}\n        partnerName={stranger?.name}\n      />\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }
