  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { X, ShieldAlert, AlertTriangle, CheckCircle, Eye, UserMinus, ShieldCheck } from \'lucide-react\';\n\ninterface RulesModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const RulesModal: React.FC<RulesModalProps> = ({ isOpen, onClose }) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div className=\"relative w-full max-w-lg bg-slate-900 border border-slate-700 rounded-2xl p-6 text-white shadow-2xl\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          aria-label=\"Close rules\"\n        >\n          <X size={18} />\n        </button>\n\n        <div className=\"flex items-center gap-3 mb-4\">\n          <div className=\"p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400\">\n            <ShieldAlert size={24} />\n          </div>\n          <div>\n            <h2 className=\"text-lg font-bold text-white\">Stream+ Safety Rules</h2>\n            <p className=\"text-xs text-slate-400\">Essential rules for all video chat participants</p>\n          </div>\n        </div>\n\n        <div className=\"space-y-3.5 text-xs text-slate-300 max-h-[60vh] overflow-y-auto pr-1\">\n          <div className=\"p-3 rounded-xl bg-slate-950/70 border border-slate-800 flex items-start gap-3\">\n            <Eye size={18} className=\"text-emerald-400 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-bold text-white block mb-0.5\">Keep Your Face Visible</span>\n              <span>Always ensure your face is well-lit and centered in the webcam frame. Covering the camera or pointing it at a wall/screen is not permitted.</span>\n            </div>\n          </div>\n\n          <div className=\"p-3 rounded-xl bg-slate-950/70 border border-slate-800 flex items-start gap-3\">\n            <ShieldCheck size={18} className=\"text-sky-400 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-bold text-white block mb-0.5\">18+ Only Community</span>\n              <span>You must be at least 18 years old to use Stream+. Minors are not permitted and will be permanently banned.</span>\n            </div>\n          </div>\n\n          <div className=\"p-3 rounded-xl bg-slate-950/70 border border-slate-800 flex items-start gap-3\">\n            <AlertTriangle size={18} className=\"text-amber-400 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-bold text-white block mb-0.5\">Zero Tolerance for Inappropriate Content</span>\n              <span>Nudity, vulgar behavior, hate speech, bullying, and sexual acts result in an instant automated hardware ban.</span>\n            </div>\n          </div>\n\n          <div className=\"p-3 rounded-xl bg-slate-950/70 border border-slate-800 flex items-start gap-3\">\n            <UserMinus size={18} className=\"text-rose-400 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-bold text-white block mb-0.5\">Respect Other Users</span>\n              <span>If someone wants to end a conversation, respect their decision. Report violators immediately using the flag button.</span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"mt-6 pt-4 border-t border-slate-800 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-colors\"\n          >\n            I Understand & Agree\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n\ninterface ReportModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onConfirmReport: (reason: string) => void;\n  partnerName?: string;\n}\n\nconst REPORT_REASONS = [\n  \'Inappropriate or offensive behavior\',\n  \'Black screen / Not showing face\',\n  \'Suspected minor / Underage user\',\n  \'Harassment or hate speech\',\n  \'Commercial spam or bot broadcast\',\n];\n\nexport const ReportModal: React.FC<ReportModalProps> = ({\n  isOpen,\n  onClose,\n  onConfirmReport,\n  partnerName,\n}) => {\n  const [selectedReason, setSelectedReason] = useState<string>(REPORT_REASONS[0]);\n  const [isSuccess, setIsSuccess] = useState<boolean>(false);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsSuccess(true);\n    setTimeout(() => {\n      onConfirmReport(selectedReason);\n      setIsSuccess(false);\n      onClose();\n    }, 1200);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div className=\"relative w-full max-w-md bg-slate-900 border border-slate-700 rounded-2xl p-6 text-white shadow-2xl\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          aria-label=\"Close report\"\n        >\n          <X size={18} />\n        </button>\n\n        {isSuccess ? (\n          <div className=\"py-8 flex flex-col items-center justify-center text-center animate-in zoom-in-95 duration-200\">\n            <CheckCircle size={48} className=\"text-emerald-400 mb-3\" />\n            <h3 className=\"text-base font-bold text-white mb-1\">Report Submitted</h3>\n            <p className=\"text-xs text-slate-300\">\n              Thank you for keeping Stream+ safe. Skipping to next partner...\n            </p>\n          </div>\n        ) : (\n          <form onSubmit={handleSubmit}>\n            <div className=\"flex items-center gap-3 mb-4\">\n              <div className=\"p-2.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400\">\n                <AlertTriangle size={22} />\n              </div>\n              <div>\n                <h2 className=\"text-base font-bold text-white\">\n                  Report {partnerName || \'User\'}\n                </h2>\n                <p className=\"text-xs text-slate-400\">\n                  Select why you are reporting this partner\n                </p>\n              </div>\n            </div>\n\n            <div className=\"space-y-2 mb-6\">\n              {REPORT_REASONS.map((reason) => (\n                <label\n                  key={reason}\n                  className={`flex items-center gap-2.5 p-3 rounded-xl border cursor-pointer text-xs transition-colors ${\n                    selectedReason === reason\n                      ? \'bg-red-950/40 border-red-500/70 text-white font-medium\'\n                      : \'bg-slate-950/60 border-slate-800 text-slate-300 hover:bg-slate-800\'\n                  }`}\n                >\n                  <input\n                    type=\"radio\"\n                    name=\"reportReason\"\n                    value={reason}\n                    checked={selectedReason === reason}\n                    onChange={() => setSelectedReason(reason)}\n                    className=\"accent-red-500\"\n                  />\n                  <span>{reason}</span>\n                </label>\n              ))}\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 transition-colors\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs transition-colors shadow-md\"\n              >\n                Report & Skip\n              </button>\n            </div>\n          </form>\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/RulesAndReportModals.tsx"
        }
        overwrite: true
      }
    }
