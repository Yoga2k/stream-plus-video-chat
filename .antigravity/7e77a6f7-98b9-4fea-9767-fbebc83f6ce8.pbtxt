        target_content: "  // TV Noise generator when stopped or searching\n  useEffect(() => {\n    let animId: number;\n    const canvas = noiseCanvasRef.current;\n    if (!canvas || status === \'connected\') return;\n\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    const width = 320;\n    const height = 240;\n    canvas.width = width;\n    canvas.height = height;\n\n    const imgData = ctx.createImageData(width, height);\n    const data = imgData.data;\n\n    const drawNoise = () => {\n      for (let i = 0; i < data.length; i += 4) {\n        // Subtle dark analog CRT static noise\n        const val = Math.random() * 70 + 20;\n        data[i] = val; // R\n        data[i + 1] = val; // G\n        data[i + 2] = val + (Math.random() > 0.95 ? 15 : 0); // slight blue/green analog tint\n        data[i + 3] = 255;\n      }\n      ctx.putImageData(imgData, 0, 0);\n      animId = requestAnimationFrame(drawNoise);\n    };\n\n    drawNoise();\n    return () => cancelAnimationFrame(animId);\n  }, [status]);"
        replacement_content: "  // TV Noise generator when stopped or searching (throttled for performance & stability)\n  useEffect(() => {\n    const canvas = noiseCanvasRef.current;\n    if (!canvas || status === \'connected\') return;\n\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    const width = 320;\n    const height = 240;\n    canvas.width = width;\n    canvas.height = height;\n\n    const imgData = ctx.createImageData(width, height);\n    const data = imgData.data;\n\n    const drawNoise = () => {\n      for (let i = 0; i < data.length; i += 4) {\n        // Subtle dark analog CRT static noise\n        const val = Math.random() * 65 + 15;\n        data[i] = val; // R\n        data[i + 1] = val; // G\n        data[i + 2] = val + (Math.random() > 0.95 ? 12 : 0); // slight analog tint\n        data[i + 3] = 255;\n      }\n      ctx.putImageData(imgData, 0, 0);\n    };\n\n    drawNoise();\n    const interval = setInterval(drawNoise, 120);\n    return () => clearInterval(interval);\n  }, [status]);"
        start_line: 36
        end_line: 68
      }
      num_matches: 1
    }
    description: "Use throttled interval for CRT static noise to save CPU and ensure screenshot stability"
